{
	"name": "@stimulcross/p-retry",
	"type": "module",
	"version": "0.2.0",
	"packageManager": "pnpm@12.8.1",
	"description": "Retry a promise-returning or async function",
	"author": "Stimul Cross",
	"license": "MIT",
	"repository": "https://github.com/StimulCross/p-retry.git",
	"keywords": [
		"promise",
		"retry",
		"retries",
		"operation",
		"failed",
		"rejected",
		"try",
		"exponential",
		"backoff",
		"attempt",
		"async",
		"await",
		"promises",
		"concurrently",
		"concurrency",
		"parallel",
		"bluebird"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"main": "lib",
	"types": "lib",
	"files": [
		"LICENSE",
		"README.md",
		"lib"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"rebuild": "pnpm run clear && pnpm run build",
		"clear": "del-cli lib",
		"prepare": "husky",
		"preversion": "pnpm run lint && pnpm run rebuild",
		"postversion": "pnpm install",
		"prepublishOnly": "pnpm run lint && pnpm run rebuild",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:verbose": "vitest --run --reporter=verbose",
		"test:cov": "vitest --run --coverage",
		"test:cov:verbose": "vitest --run --coverage --reporter=verbose"
	},
	"devDependencies": {
		"@stimulcross/commitlint-config": "^2.0.0",
		"@stimulcross/eslint-config": "^0.0.4",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.3",
		"commitlint": "^21.2.3",
		"del-cli": "^7.0.0",
		"eslint": "^10.11.0",
		"eslint-plugin-format": "^2.0.1",
		"husky": "^9.1.7",
		"nano-staged": "^1.0.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"nano-staged": {
		"*": "eslint --fix"
	}
}
