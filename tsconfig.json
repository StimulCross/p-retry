{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],

		"module": "Node20",
		"moduleResolution": "Node16",
		"types": ["node"],

		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"verbatimModuleSyntax": true,

		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,

		"noEmit": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "lib", "coverage"]
}
